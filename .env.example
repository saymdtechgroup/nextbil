# Server Backend Environment Variables (.env)
# ===============================================================
# ⚠️ SECURITY: Keep these values secret on your server / hosting environment.
# DO NOT expose private keys in frontend or git.

# 1. Automated Payout Hot Wallet (For instant automated USDT withdrawals)
# Enter the private key of your designated Hot Wallet (starts with 0x):
PAYOUT_HOT_WALLET_PRIVATE_KEY=
SAFEPAL_WALLET_ADDRESS=
SAFEPAL_PRIVATE_KEY=

# 2. Blockchain RPC Node & Contract Details (Binance Smart Chain BEP-20)
RPC_URL=https://bsc-dataseed.binance.org/
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# 3. Security Master PIN & Admin
ADMIN_SECRET_PIN=7788
PORT=3000

